# =============================================================================
# .env.gotrue.template — plantilla del env de la GoTrue DEDICADA del copiloto.
#
# El archivo REAL vive server-side en /etc/unreal-copilot/copiloto-gotrue.env
# (chmod 600), lo GENERA `deploy-gotrue.sh` la primera vez (secreto + keys
# aleatorios) y es idempotente (no regenera si ya existe). NUNCA se commitea con
# valores reales — este .template solo documenta el contrato.
#
# "Cero fricción para escalar": clonar la GoTrue para otro tenant/región = copiar
# este template a otro copiloto-gotrue-<x>.env + otro COMPOSE_PROJECT_NAME + otros
# puertos. Cero edición del compose ni del código.
# =============================================================================

# Nombre del proyecto compose (aísla containers/volumen/red por instancia)
COMPOSE_PROJECT_NAME=copiloto-auth

# Puerto loopback del proxy (SUPABASE_URL del copiloto apunta acá)
COPILOTO_AUTH_PORT=9997

# URL drop-in que consume el copiloto (loopback + /auth/v1 via proxy)
COPILOTO_SUPABASE_URL=http://127.0.0.1:9997

# Secreto HS256 PROPIO (NUNCA el SUPABASE_JWT_SECRET de fusion). openssl rand -hex 32
COPILOTO_JWT_SECRET=__GENERATED_BY_DEPLOY__

# Issuer PROPIO → es el claim `iss` que Fase 2 valida (cierra el SSO-by-accident).
# Debe ser estable: cambiarlo invalida los tokens en vuelo.
COPILOTO_JWT_ISSUER=https://copiloto-auth.local/auth/v1

# SITE_URL / allow-list de redirects (para OAuth y magic links)
GOTRUE_SITE_URL=https://copiloto.178-105-191-1.sslip.io
GOTRUE_URI_ALLOW_LIST=https://copiloto.178-105-191-1.sslip.io/*

# Password del Postgres dedicado. openssl rand -hex 24
GOTRUE_PG_PASSWORD=__GENERATED_BY_DEPLOY__
GOTRUE_PG_DB=postgres

# Versiones pinneadas (nunca latest)
GOTRUE_TAG=v2.186.0
CADDY_TAG=2
GOTRUE_JWT_EXP=3600
GOTRUE_DISABLE_SIGNUP=true

# --- Keys derivadas (JWT firmados con COPILOTO_JWT_SECRET) — las genera deploy-gotrue.sh ---
# SERVICE_ROLE_KEY: {role:service_role} → Bearer de las llamadas admin del backend
# ANON_KEY:         {role:anon}         → apikey del frontend en endpoints públicos
COPILOTO_SERVICE_ROLE_KEY=__GENERATED_BY_DEPLOY__
COPILOTO_ANON_KEY=__GENERATED_BY_DEPLOY__

# --- Google OAuth (Fase 5) — SLOT: dejar en false/vacío hasta cargar las creds del operador ---
# Crear en Google Cloud Console (OAuth client "Web"): client_id + secret + redirect
# URI = <vhost público del proxy>/auth/v1/callback
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=
