[Unit]
Description=Copiloto del Emprendedor - front-door web (FastAPI+Temporal, multitenant)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/uc-repos/copiloto/apps/copiloto
Environment=PYTHONPATH=/opt/uc-repos/copiloto/motor:/opt/uc-repos/copiloto/deploy/worker
EnvironmentFile=/etc/unreal-copilot/copiloto.env
EnvironmentFile=/etc/unreal-copilot/fusion-pg.env
EnvironmentFile=/etc/unreal-copilot/fusion-supabase.env
ExecStart=/opt/uc-copiloto-venv/bin/python -m serve
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
# --- Sandboxing (SEC-A1-3, auditoría 2026-11-04): corre como root por los .env 600 y /opt, pero sin
#     capabilities, sin privilegios nuevos y con el sistema de archivos del host de sólo lectura. ---
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectSystem=full
# ProtectHome NO: el SDK de Composio escribe en /root/.composio (medido: 8 FAIL de smoke con ProtectHome=yes)
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
