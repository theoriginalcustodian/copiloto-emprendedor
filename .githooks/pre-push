#!/usr/bin/env bash
# .githooks/pre-push — sync del grafo de código (arco autopoiético, onboardeo 2026-07-23).
# Activar (por clone): git config core.hooksPath .githooks
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# git entrega por stdin una línea por ref — se consume ahora (pipe, una sola lectura).
REFS_STDIN="$(cat || true)"

# BL-B3 — repo PÚBLICO: ANTES de cualquier otra cosa (incluido el atajo "grafo ya sincronizado"), se
# escanean los commits que se pushean. Fail-closed: hallazgo o escáner roto ⇒ el push aborta.
# Bypass consciente y visible: git push --no-verify.
printf '%s
' "$REFS_STDIN" | bash "$SCRIPT_DIR/scripts/secretos-check.sh" --refs-stdin || {
  echo "[pre-push] ❌ secretos-check falló: el push se aborta (repo PÚBLICO)." >&2; exit 1; }

# --- Gate de ATRIBUCIÓN (modo REPORTE) ------------------------------------------------
# No bloquea: imprime qué fracción de los commits que se pushean cita un trabajo
# autorizado. Existe porque había 17 gates midiendo CALIDAD y ninguno PERTINENCIA
# (forense 2026-10-08: 64 PRs en un día, 4 del backlog, con 113 ids disponibles).
# Pasa a bloqueante con UC_ATRIBUCION_BLOQUEA=1 cuando el operador lo decida; el umbral
# se fija con el ratio medido, no con una intuición.
# Un fallo del gate NO puede voltear un push en modo reporte: || true es deliberado.
if [ -f "$SCRIPT_DIR/scripts/ci/atribucion.sh" ]; then
  _base_atr="$(git merge-base origin/main HEAD 2>/dev/null || true)"
  if [ -n "$_base_atr" ]; then
    bash "$SCRIPT_DIR/scripts/ci/atribucion.sh" "$_base_atr..HEAD" || true
  fi
fi

# -----------------------------------------------------------------------------
# Sync del grafo de código (arco autopoiético)
# -----------------------------------------------------------------------------
# Extrae el grafo con graphify (0 LLM, incremental) e ingiere solo lo cambiado
# desde el último commit ya pusheado, reconciliando contra el grafo completo
# (alta + baja). Fail-closed: si el sync falla, el push ABORTA — el grafo no
# queda silenciosamente desactualizado. Bypass ante fallo transitorio:
# git push --no-verify. Patrón copiado de Graphity (.githooks/pre-push §8) /
# unreal-copilot (.githooks/pre-push). La invocación real (con status/errores/control
# positivo verificados) vive en scripts/graph-sync.sh — este hook SOLO decide el
# alcance (incremental vs completo) y le delega la ejecución.
ZERO="0000000000000000000000000000000000000000"
BRIDGE="${GRAPHITY_BRIDGE_PATH:-C:/Proyectos/Claude/Claude code/graphify-graphity-bridge}"
REPO_NAME="${GRAPHITY_REPO_NAME:-copiloto-emprendedor}"
CHECKPOINT_REL=".bridge/checkpoint-${REPO_NAME}.db"
MERGE_BASE_REF="${GRAPHITY_MERGE_BASE_REF:-origin/main}"

if [ ! -d "$BRIDGE" ]; then
  echo "[pre-push] ❌ no encuentro el bridge en '$BRIDGE'." >&2
  echo "[pre-push]    seteá GRAPHITY_BRIDGE_PATH o saltá con: git push --no-verify" >&2
  exit 1
fi
if ! command -v uv >/dev/null 2>&1; then
  echo "[pre-push] ❌ 'uv' no está en el PATH; no se puede sincronizar el grafo." >&2
  exit 1
fi

# -----------------------------------------------------------------------------
# 2026-07-31 — el grafo se sincroniza desde origin/main, NO desde la rama que se pushea.
# -----------------------------------------------------------------------------
# Decisión del operador: el grafo es el modelo de la app sobre sí misma y lo consume el ciclo de
# autosanación; su verdad es lo que puede llegar a producción, no el trabajo en vuelo de cada frente.
# Antes esto sincronizaba la rama pusheada leyendo el WORKING TREE del checkout compartido — que
# está en una rama y llegó a estar 111 commits detrás de main. Resultado: contenido de hoy con
# `valid_at` de hace 4 días, y nodos de código que no estaba en ninguna rama.
#
# Ahora: si origin/main NO se movió desde el último sync exitoso, no hay nada que hacer y el push
# sigue de largo (pushear una rama de trabajo ya no paga el costo del sync). Si SÍ se movió —o sea,
# alguien mergeó— se sincroniza, y sigue siendo fail-closed: si falla, el push aborta.
# Bypass ante fallo transitorio: git push --no-verify.
git fetch origin main --quiet 2>/dev/null || true
MAIN_SHA="$(git rev-parse origin/main 2>/dev/null || echo desconocido)"
MARCADOR="$BRIDGE/.bridge/last-synced-copiloto-emprendedor.sha"
ULTIMO="$(cat "$MARCADOR" 2>/dev/null || echo ninguno)"
if [ "$MAIN_SHA" = "$ULTIMO" ]; then
  echo "[pre-push] (grafo ya sincronizado con origin/main @ ${MAIN_SHA:0:12} — nada que hacer)"

  exit 0
fi
echo "[pre-push] origin/main se movió (${ULTIMO:0:12} -> ${MAIN_SHA:0:12}); sincronizando el grafo…"
# 🔴 2026-10-14 — el rc se CAPTURA en vez de matar el hook. Con `set -euo pipefail` (línea 4), esta
# llamada SIN `||` se llevaba el push puesto cuando `graph-sync.sh` salía ≠ 0, y todo el manejo
# cuidadoso de abajo —el chequeo del marcador, que YA degrada a warning sin abortar— NUNCA se
# alcanzaba en ese caso. El comentario de la línea 37 declara «fail-closed» y describe un diseño que
# el código de la línea 90 ya contradecía: por eso el hueco vivió tres meses sin que nadie lo viera.
# Medido: pasó 3 veces (221 objetos el 31-07, 1406 el 30-09, 218 el 14-10), SIEMPRE por una re-poda
# LEGÍTIMA que supera el tope absoluto de 200 del reconcile (`differ.py:27`). Superar ese tope NO es
# un bug: `differ.py:21-26` lo declara esperable y ofrece `--force` como salida consciente. El bug
# era que un sistema AUXILIAR —la memoria del código— tuviera VETO sobre TODO push de la flota,
# incluido el de quien no tocó el grafo. El 14-10 dejó a tres sesiones sin poder pushear.
# El trato ahora es el MISMO que ya tenía la contención del lock: se avisa, el marcador queda viejo
# y el próximo push reintenta. Los otros dos gates de este hook ya llevan su `|| true` deliberado
# (atribución, línea 28); el del grafo era el único que no, y sin motivo escrito.
# ⚠️ Lo que este fix NO hace: no silencia nada. El bloque `GRAPH_RC -ne 0` de abajo imprime el rc y el
# destrabe, porque un fallo degradado a warning MUDO es peor que el abort — nadie lo persigue.
GRAPH_RC=0
bash "$(git rev-parse --show-toplevel)/scripts/graph-sync.sh" || GRAPH_RC=$?
# El ✅ NO se declara por haber llamado al script: se declara contra el marcador, que graph-sync.sh
# escribe SOLO al final, después de sus 3 capas de verificación (graph-sync.sh:263). Hay un camino
# real de exit 0 sin sincronizar — el lock ocupado por otro push concurrente (graph-sync.sh:155-156)
# sale antes de escribirlo. Ese caso NO aborta el push (es contención, no fallo: el marcador queda
# viejo y el próximo push reintenta), pero tampoco puede reportarse como sincronizado.
# Raíz 2026-08-19: el echo era incondicional y anunció "✅ sincronizado" sobre un sync que había
# salido sin tocar el árbol. Ver memoria/instrumentos-que-confirman-en-vez-de-verificar.md.
# Un fallo degradado a warning MUDO es peor que el abort: nadie lo persigue. Si el sync fallo el
# push SIGUE (el grafo es auxiliar), pero el rc y el camino de destrabe quedan impresos en stderr.
# Va ANTES del chequeo del marcador y condicionado a rc != 0 a proposito: rc=0 con marcador viejo
# es contencion del lock (graph-sync.sh:155-156), caso benigno donde gritar el destrabe seria un
# falso positivo — y un guard que grita en el caso normal se desarma solo.
if [ "$GRAPH_RC" -ne 0 ]; then
  {
    echo "[pre-push] ⚠️  graph-sync.sh salió rc=$GRAPH_RC — el push SIGUE (el grafo es auxiliar), pero el grafo quedó desactualizado."
    echo "[pre-push]    1) ver QUÉ borraría, sin borrar nada:  powershell -ExecutionPolicy Bypass -File scripts/destrabar-grafo-force.ps1"
    echo "[pre-push]    2) si la lista cierra: el mismo comando con -Force (borra del grafo COMPARTIDO por las 4 sesiones)."
    echo "[pre-push]    El paso 1 aborta solo si hay faltantes GRAVES; las auto-aristas benignas no bloquean (son 11 hoy)."
  } >&2
fi
if [ "$(cat "$MARCADOR" 2>/dev/null || echo ninguno)" = "$MAIN_SHA" ]; then
  echo "[pre-push] ✅ grafo de código sincronizado desde origin/main @ ${MAIN_SHA:0:12}"
else
  echo "[pre-push] ⚠️  el sync NO completó (marcador sigue en ${ULTIMO:0:12}, esperado ${MAIN_SHA:0:12}) — el próximo push reintenta." >&2
fi
exit 0

# ----- (muerto desde 2026-07-31; se conserva un ciclo por si hay que volver atrás) -----
# El grafo YA conoce este repo si el checkpoint tiene al menos un chunk 'done' para él.
# Ojo (vacío-es-pregunta): CheckpointStore crea el archivo (schema vacío) con solo
# instanciarse — su mera EXISTENCIA no prueba que haya datos; hay que contar filas.
graph_conoce_el_repo() {
  local ckpt="$BRIDGE/$CHECKPOINT_REL"
  [ -f "$ckpt" ] || return 1
  local n
  n="$(cd "$BRIDGE" && uv run python -c "
import sqlite3, sys
conn = sqlite3.connect(sys.argv[1])
try:
    row = conn.execute('SELECT COUNT(*) FROM chunks WHERE repo=? AND done=1', (sys.argv[2],)).fetchone()
    print(row[0] if row else 0)
except sqlite3.OperationalError:
    print(0)
" "$ckpt" "$REPO_NAME" 2>/dev/null || echo 0)"
  [ "${n:-0}" -gt 0 ]
}

base=""
full=0
nrefs=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  case "$local_sha" in *[!0]*) : ;; *) continue ;; esac
  nrefs=$((nrefs + 1))
  if [ "${remote_sha:-$ZERO}" = "$ZERO" ]; then
    # Rama nueva en origin — el bug era leer esto como "el grafo no sabe nada del repo"
    # y resincronizar TODO (frenó el hito 9 dos veces; el push queda indistinguible de
    # un cuelgue). "Rama nueva en origin" y "grafo vacío" son preguntas DISTINTAS: si el
    # grafo ya conoce el repo, alcance incremental contra el merge-base con la rama
    # principal; si está genuinamente vacío (o no hay merge-base resoluble), full — ese
    # es el caso que el control negativo del DoD tiene que atrapar.
    if graph_conoce_el_repo && mb="$(git merge-base "$MERGE_BASE_REF" "$local_sha" 2>/dev/null)" && [ -n "$mb" ]; then
      base="$mb"
    else
      full=1
    fi
  else
    base="$remote_sha"
  fi
done <<< "$REFS_STDIN"
[ "$nrefs" -gt 1 ] && full=1

if [ "$nrefs" -eq 0 ]; then
  echo "[pre-push] (nada que sincronizar en el grafo)"
else
  if [ "$full" -eq 0 ] && [ -n "$base" ]; then
    n_files="$(git diff --name-only "$base"..HEAD | wc -l | tr -d ' ')"
    echo "[pre-push] alcance: incremental desde ${base:0:12} (${n_files} archivo(s) cambiado(s))"
    bash "$SCRIPT_DIR/scripts/graph-sync.sh" --since "$base"
  else
    n_files="$(git ls-files | wc -l | tr -d ' ')"
    echo "[pre-push] alcance: completo (${n_files} archivo(s) trackeado(s))"
    bash "$SCRIPT_DIR/scripts/graph-sync.sh"
  fi
fi
